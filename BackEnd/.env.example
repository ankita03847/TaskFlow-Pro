# BackEnd Environment Variables Template
# Copy this file to .env and fill in your actual values

# MongoDB connection string (from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/taskmanager?retryWrites=true&w=majority

# JWT Secret Key for token signing
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Secret code required when registering an Admin account
ADMIN_INVITE_TOKEN=4588944

# Port for local development
PORT=8080

# FrontEnd URL for CORS policy in production (optional, defaults to * if omitted)
CLIENT_URL=http://localhost:5173
